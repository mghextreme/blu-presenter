# SUPABASE

SUPABASE_URL=
# Publishable key (sb_publishable_...) — used on Supabase hosted platform
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key (JWT) — required for local dev with Supabase CLI
SUPABASE_KEY=
# Service role key (server-only, NEVER expose to the frontend). Required for
# admin actions such as signing out other sessions after a password change.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# APP

APP_BASE_URL=http://localhost:5173

# API

VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PORT=3000

# API Documentation
# Set to true to enable Swagger UI at /docs (development only)
ENABLE_API_DOCS=true

# DATABASE

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=54322
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# Cloudflare

CLOUDFLARE_API_TOKEN=${CLOUDFLARE_TOKEN}

# Captcha
# Set disable = true for running locally

DISABLE_CAPTCHA=true
VITE_DISABLE_CAPTCHA=true
VITE_TURNSTILE_SITE_KEY=

