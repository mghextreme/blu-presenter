# SUPABASE

SUPABASE_URL=
# Publishable key (sb_publishable_...) — used on Supabase hosted platform
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key (JWT) — required for local dev with Supabase CLI
SUPABASE_KEY=

# The callback URL Supabase sends to OAuth providers (registered in each
# provider's dashboard). Local: the 127.0.0.1 form of the CLI's auth callback
# (Spotify rejects redirect URIs containing "localhost").
SUPABASE_AUTH_REDIRECT_URI=

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Spotify (Supabase sign-in provider + API integration for schedule playlists)
SUPABASE_AUTH_EXTERNAL_SPOTIFY_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_SPOTIFY_SECRET=

# Used by the API to create/re-sync playlists on behalf of connected users.
# Without these, the Spotify card is hidden from the profile page. Playlists
# are also opt-in per user, via an "enabled" flag in users."spotify":
#   update public.users set spotify = coalesce(spotify, '{}') || '{"enabled": true}' where ...;
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# HMAC key protecting the OAuth state of the connect flow (falls back to SPOTIFY_CLIENT_SECRET)
SPOTIFY_STATE_SECRET=

# YouTube (API integration for schedule playlists). A Google OAuth client with
# the YouTube Data API v3 enabled — it can be the sign-in client above — with
# <APP_BASE_URL>/app/youtube/connect-callback as an authorized redirect URI.
# Once set, every user can connect YouTube from the Google card on the
# profile page; without these, the option is hidden.
# The youtube scope is sensitive: production needs Google's app verification,
# and while the OAuth app is in "Testing", refresh tokens expire after 7 days.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# HMAC key protecting the OAuth state of the connect flow (falls back to YOUTUBE_CLIENT_SECRET)
YOUTUBE_STATE_SECRET=

# APP
# Note: use 127.0.0.1 (not localhost) for local development — Spotify rejects
# redirect URIs containing "localhost".

APP_BASE_URL=http://127.0.0.1:5173

# API

VITE_API_PROTOCOL=http
VITE_API_HOST=localhost
VITE_API_PORT=3000

# API Documentation
# Set to true to enable Swagger UI at /docs (development only)
ENABLE_API_DOCS=true

# DATABASE

DATABASE_HOST=localhost
DATABASE_PORT=54322
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres
# TLS to the database, with certificate verification (off locally).
# DATABASE_SSL=true
# PEM of a private CA to verify against, e.g. Supabase's (Database settings →
# SSL configuration). Implies DATABASE_SSL. "\n" escapes are accepted.
# DATABASE_SSL_CA=
# Connections per API instance (driver default: 10).
# DATABASE_POOL_SIZE=10

# Cloudflare

CLOUDFLARE_API_TOKEN=${CLOUDFLARE_TOKEN}

# Captcha
# Set disable = true for running locally

DISABLE_CAPTCHA=true
VITE_DISABLE_CAPTCHA=true
VITE_TURNSTILE_SITE_KEY=

# VCS song sync (more at api/src/vcs-sync/README.md)

GITHUB_TOKEN=

